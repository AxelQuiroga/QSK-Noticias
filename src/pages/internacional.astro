---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCountryName } from '@/lib/international';
import { getPublishedArticles } from '../lib/articles';

const internationalArticles = (await getPublishedArticles())
  .filter((article) => article.data.section === 'Internacional')
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() -
      new Date(a.data.publishedAt).getTime(),
  );

const title = 'Internacional | QSK Noticias';
const description =
  'Noticias internacionales: información y actualidad del mundo.';
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">
        Cobertura internacional
      </p>

      <h1 class="mb-3 text-3xl font-bold text-foreground md:text-4xl">
        Internacional
      </h1>

      <p class="max-w-3xl text-muted-foreground">
        Las noticias del mundo, con información sobre los principales
        acontecimientos internacionales.
      </p>
    </header>

    <section aria-label="Noticias internacionales">
      {internationalArticles.length === 0 ? (
        <div class="rounded-lg border border-border p-8 text-center">
          <h2 class="mb-2 text-xl font-semibold">
            Todavía no hay noticias internacionales
          </h2>
          <p class="text-muted-foreground">
            Estamos preparando la cobertura internacional de QSK Noticias.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {internationalArticles.map((article) => (
            <div>
              {article.data.country && (
                <p class="mb-2 text-sm font-medium text-primary">
                  {getCountryName(article.data.country) ??
                    article.data.country}
                </p>
              )}

              <ArticleCard article={article} />
            </div>
          ))}
        </div>
      )}
    </section>
  </main>
</BaseLayout>
