---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import NovedadesOficialesCarousel from '../components/NovedadesOficialesCarousel.astro';
import OleDeportesCarousel from '../components/OleDeportesCarousel.astro';
import NationalNewsCarousel from '../components/NationalNewsCarousel.astro';
import { getFeaturedArticle, getLatestArticles } from '../lib/articles';
import { slugify } from '../lib/utils';
import { SECTIONS } from '../data/sections';
import { getLocationsByType, locationSlug } from '../data/locations';

const featured = await getFeaturedArticle();
const latest = await getLatestArticles(6, featured?.data.slug);
const sections = SECTIONS;
const municipios = getLocationsByType('municipio');
const regiones = getLocationsByType('region');
---

<BaseLayout
  title="QSK Noticias — La información que nos conecta"
  description="Medio digital independiente con raíces en Zona Sur del Gran Buenos Aires y cobertura de AMBA, Argentina y el mundo."
>
  <div class="container-editorial pb-14 pt-7 sm:pt-10">
    <section class="mb-8 border-b border-border pb-6 sm:mb-10" aria-labelledby="home-title">
      <p class="eyebrow">Zona Sur · AMBA · Argentina · Mundo</p>
      <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-3xl">
          <h1 id="home-title" class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl lg:text-5xl">
            La información que nos conecta.
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
            QSK Noticias es un medio digital independiente con raíces en Zona Sur del Gran Buenos Aires y una mirada que alcanza toda la actualidad: AMBA, Argentina y el mundo.
          </p>
        </div>
        <p class="hidden shrink-0 border-l-2 border-info pl-4 text-sm font-medium leading-relaxed text-text-secondary md:block">
          Un medio independiente<br />con foco en lo que importa.
        </p>
      </div>
    </section>

    <WeatherWidget />

    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_300px] xl:gap-12">
      <div class="min-w-0">
        {featured && (
          <section aria-labelledby="featured-heading">
            <div class="section-heading">
              <h2 id="featured-heading" class="section-title">Destacado</h2>
              <span class="eyebrow">En primer plano</span>
            </div>
            <ArticleCard article={featured} variant="featured" />
          </section>
        )}

        <section class="mt-10 sm:mt-12" aria-labelledby="latest-heading">
          <div class="section-heading">
            <h2 id="latest-heading" class="section-title">Últimas noticias</h2>
            <span class="text-sm text-text-secondary">Lo más reciente</span>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {latest.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </section>

        <NationalNewsCarousel limit={6} />
        <OleDeportesCarousel limit={10} />
        <NovedadesOficialesCarousel fuenteId="gba" limit={12} />
        <NovedadesOficialesCarousel fuenteId="esteban-echeverria" limit={12} />
        <NovedadesOficialesCarousel fuenteId="avellaneda" limit={12} />
        <NovedadesOficialesCarousel fuenteId="lanus" limit={12} />
      </div>

      <aside class="grid gap-8 sm:grid-cols-2 lg:sticky lg:top-24 lg:grid-cols-1">
        <section class="rounded-xl border border-border bg-surface p-5" aria-labelledby="sections-heading">
          <div class="section-heading mb-4 pb-3">
            <h2 id="sections-heading" class="section-title text-lg">Secciones</h2>
          </div>
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-1">
            {sections.map((section) => (
              <li>
                <a
                  href={`/secciones/${slugify(section)}/`}
                  class="flex min-h-10 items-center justify-between gap-2 rounded-lg border border-border/80 px-3 py-2 text-sm font-semibold text-text-secondary transition-colors hover:border-info hover:bg-surface-raised hover:text-text"
                >
                  {section}
                  <span aria-hidden="true" class="text-info">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="rounded-xl border border-border bg-surface p-5" aria-labelledby="municipalities-heading">
          <div class="section-heading mb-4 pb-3">
            <h2 id="municipalities-heading" class="section-title text-lg">Municipios</h2>
          </div>
          <ul class="flex flex-wrap gap-2">
            {municipios.map((location) => (
              <li>
                <a
                  href={`/municipios/${locationSlug(location)}/`}
                  class="inline-flex rounded-full border border-border px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:border-info hover:text-text"
                >
                  {location.name}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="rounded-xl border border-border bg-[#0c2034] p-5 sm:col-span-2 lg:col-span-1" aria-labelledby="regions-heading">
          <p class="eyebrow">Cobertura</p>
          <h2 id="regions-heading" class="mt-2 font-heading text-lg font-extrabold text-text">Más allá de lo local</h2>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">Seguimos la actualidad metropolitana, nacional e internacional, sin perder el foco en Zona Sur.</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {regiones.map((location) => (
              <li>
                <a
                  href={`/regiones/${locationSlug(location)}/`}
                  class="text-sm font-semibold text-accent hover:underline"
                >
                  {location.name}
                </a>
              </li>
            ))}
            <li>
              <a
                href="/internacional/"
                class="text-sm font-semibold text-accent hover:underline"
              >
                Internacional
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
