---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getNoticiasOle } from '../../../lib/ole';
import { formatDate } from '../../../lib/utils';

const noticias = getNoticiasOle(10);
---

<BaseLayout
  title="Últimas noticias de Olé — QSK Noticias"
  description="Un listado de las últimas noticias deportivas publicadas por Olé, con enlaces a sus artículos originales."
  canonical="/fuentes/ole/"
>
  <div class="container-editorial pb-14 pt-7 sm:pt-10">
    <header class="mb-8 border-b border-border pb-6">
      <p class="eyebrow">Deportes · Fuente externa</p>
      <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
        Últimas noticias de <span class="text-accent">Olé</span>
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-text-secondary">
        Selección de titulares publicados por Olé. Cada enlace lleva a la publicación original; este listado no forma parte de las noticias redactadas por QSK.
      </p>
      <p class="mt-3 text-sm text-text-secondary">
        Fuente: <a href="https://www.ole.com.ar/" target="_blank" rel="noopener noreferrer" class="font-semibold text-accent underline underline-offset-4 hover:no-underline">Olé ↗</a>
      </p>
    </header>

    {noticias.length > 0 ? (
      <section aria-label="Últimas noticias de Olé" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {noticias.map((noticia) => (
          <article class="flex min-w-0 flex-col overflow-hidden rounded-xl border border-border bg-surface">
            {noticia.imageUrl && (
              <a
                href={noticia.url}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
                class="block aspect-[16/9] overflow-hidden bg-surface-raised"
              >
                <img
                  src={noticia.imageUrl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.02]"
                />
              </a>
            )}
            <div class="flex flex-1 flex-col p-4">
              <div class="flex items-center justify-between gap-3">
                <span class="text-xs font-bold uppercase tracking-wide text-info">Olé</span>
                {noticia.publishedAt && (
                  <time datetime={new Date(noticia.publishedAt).toISOString()} class="text-xs text-text-secondary">
                    {formatDate(new Date(noticia.publishedAt))}
                  </time>
                )}
              </div>
              <h2 class="mt-3 font-heading text-lg font-extrabold leading-snug tracking-tight text-text">
                <a
                  href={noticia.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent hover:underline"
                >
                  {noticia.title}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </h2>
              <p class="mt-auto pt-4 text-xs text-text-secondary">
                Publicado originalmente por Olé
              </p>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="rounded-xl border border-border bg-surface p-6" aria-labelledby="ole-empty-title">
        <h2 id="ole-empty-title" class="font-heading text-lg font-bold text-text">Todavía no hay noticias disponibles</h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary">
          El listado de Olé todavía no recibió publicaciones. Cuando el feed entregue datos válidos, aparecerán acá automáticamente.
        </p>
      </section>
    )}
  </div>
</BaseLayout>
