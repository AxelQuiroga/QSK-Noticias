---
import BaseLayout from '../layouts/BaseLayout.astro';
import GacetillasProvincia from '../components/GacetillasProvincia.astro';
---

<BaseLayout
  title="Actualidad bonaerense — QSK Noticias"
  description="Últimas gacetillas oficiales del Gobierno de la Provincia de Buenos Aires, con enlaces a la fuente original."
>
  <div class="container-editorial pb-14 pt-7 sm:pt-10">
    <header class="mb-8 border-b border-border pb-6">
      <p class="eyebrow">Fuente oficial · Provincia de Buenos Aires</p>
      <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">Actualidad bonaerense</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-text-secondary">Gacetillas publicadas por el Gobierno de la Provincia de Buenos Aires. Cada título enlaza a la publicación original; QSK reproduce la información breve del listado oficial.</p>
    </header>
    <GacetillasProvincia limit={15} />
  </div>
</BaseLayout>
