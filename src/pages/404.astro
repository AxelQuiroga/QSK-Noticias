---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada — QSK Noticias"
  description="La página que buscas no existe."
>
  <div class="container-editorial py-20 text-center">
    <h1 class="font-heading text-6xl font-extrabold text-accent">404</h1>
    <p class="mt-4 text-lg text-text-secondary">
      La página que buscas no existe o fue movida.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent/90"
    >
      Volver a la portada
    </a>
  </div>
</BaseLayout>
