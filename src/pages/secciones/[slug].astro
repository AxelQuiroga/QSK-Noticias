---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import OleNewsCard from '../../components/OleNewsCard.astro';
import {
  getActualidadArticles,
  getArticlesBySection,
  getArticlesByTopic,
  slugify,
} from '../../lib/articles';
import { ACTUALIDAD_SECTION, SECTIONS, TOPICS } from '../../data/sections';
import { ACTUALIDAD_WINDOW_DAYS } from '../../lib/actualidad';
import { getNoticiasDeportes } from '../../lib/deportes';

export async function getStaticPaths() {
  // Rutas estáticas para todo el catálogo: los diez topics oficiales más las
  // secciones de compatibilidad. `Actualidad` conserva su URL, aunque ya no
  // sea una categoría editorial.
  return SECTIONS.map((section) => ({
  params: { slug: slugify(section) },
  props: {
    section,
    topic: TOPICS.includes(section) ? section : undefined,
  },
}));
}

const { section, topic } = Astro.props as { section: string; topic?: string };

// `Actualidad` dejó de ser una sección con artículos propios: su página es el
// listado de las noticias publicadas dentro de la ventana temporal
// (`src/lib/actualidad.ts`).
const isActualidad = section === ACTUALIDAD_SECTION;

// Determinar el tipo de página: topic, sección de compatibilidad o Actualidad
const isTopicPage = !isActualidad && !!topic && TOPICS.includes(topic);
const useTopic = isTopicPage;

// Obtener artículos: Actualidad → ventana temporal; topic → clasificación
// temática; sección de compatibilidad → campo `section` del frontmatter.
const sorted = isActualidad
  ? await getActualidadArticles()
  : useTopic
    ? topic === 'Deportes'
      ? await getNoticiasDeportes()
      : await getArticlesByTopic(topic ?? '')
    : await getArticlesBySection(section ?? '');

const plural = sorted.length === 1 ? 'artículo' : 'artículos';
const summary = isActualidad
  ? `${sorted.length} ${plural} publicados en los últimos ${ACTUALIDAD_WINDOW_DAYS} días.`
  : `${sorted.length} ${plural} en esta sección.`;
const description = isActualidad
  ? `Últimas noticias publicadas en QSK Noticias: los artículos de los últimos ${ACTUALIDAD_WINDOW_DAYS} días en Zona Sur del conurbano bonaerense.`
  : `Noticias de ${topic ?? section} en Zona Sur del conurbano bonaerense.`;
---

<BaseLayout
  title={`${section ?? topic} — QSK Noticias`}
  description={description}
>
  <div class="container-editorial py-10">
    <header>
      <h1 class="font-heading text-3xl font-extrabold tracking-tight text-text">
        {section}
      </h1>
      <p class="mt-2 text-text-secondary">
        {summary}
      </p>
    </header>

    {sorted.length > 0 ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((item) => (
          'tipo' in item
            ? item.tipo === 'qsk'
              ? <ArticleCard article={item.article} />
              : <OleNewsCard noticia={item.noticia} />
            : <ArticleCard article={item} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-text-secondary">
        {isActualidad
          ? `No hay artículos publicados en los últimos ${ACTUALIDAD_WINDOW_DAYS} días.`
          : 'No hay artículos publicados en esta sección todavía.'}
      </p>
    )}
  </div>
</BaseLayout>
