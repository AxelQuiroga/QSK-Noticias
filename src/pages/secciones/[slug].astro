---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticlesBySection, slugify } from '../../lib/articles';
import { SECTIONS } from '../../data/sections';

export async function getStaticPaths() {
  return SECTIONS.map((section) => ({
    params: { slug: slugify(section) },
    props: { section },
  }));
}

const { section } = Astro.props;
const sorted = await getArticlesBySection(section);
---

<BaseLayout
  title={`${section} — SAQL Noticias`}
  description={`Noticias de la sección ${section} en Zona Sur del conurbano bonaerense.`}
>
  <div class="container-editorial py-10">
    <header>
      <h1 class="font-heading text-3xl font-extrabold tracking-tight text-text">
        {section}
      </h1>
      <p class="mt-2 text-text-secondary">
        {sorted.length} {sorted.length === 1 ? 'artículo' : 'artículos'} en esta sección.
      </p>
    </header>

    {sorted.length > 0 ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-text-secondary">
        No hay artículos publicados en esta sección todavía.
      </p>
    )}
  </div>
</BaseLayout>
