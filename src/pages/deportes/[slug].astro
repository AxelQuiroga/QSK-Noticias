---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SharePublication from '../../components/SharePublication.astro';
import { getTodasNoticiasOle, getOleSlug } from '../../lib/ole';
import { formatDate } from '../../lib/utils';

export function getStaticPaths() {
  return getTodasNoticiasOle().map((noticia) => ({
    params: { slug: getOleSlug(noticia) },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const slug = getOleSlug(noticia);
const fecha = noticia.publishedAt ? new Date(noticia.publishedAt) : null;
const fechaValida = fecha && !Number.isNaN(fecha.getTime()) ? fecha : null;
const descripcionNoticia = noticia.description?.trim();
const descripcion = descripcionNoticia || `Noticia deportiva publicada originalmente por Olé. Leé la publicación original en el sitio de la fuente.`;
---

<BaseLayout
  title={`${noticia.title} — Deportes — QSK Noticias`}
  description={descripcion}
  canonical={`/deportes/${slug}/`}
>
  <article class="container-editorial py-10">
    <nav aria-label="Miga de pan" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-text-secondary">
        <li><a href="/" class="hover:text-text">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/secciones/deportes/" class="hover:text-text">Deportes</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="max-w-[16rem] truncate">Olé</li>
      </ol>
    </nav>

    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">Deportes · Fuente: Olé</p>
      <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
        {noticia.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-text-secondary">
        <span>Publicado originalmente por <strong class="font-medium text-text">Olé</strong></span>
        {fechaValida && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={fechaValida.toISOString()}>{formatDate(fechaValida)}</time>
          </>
        )}
      </div>
    </header>

    <SharePublication
      title={`${noticia.title} — Deportes — QSK Noticias`}
      description={descripcion}
      url={new URL(`/deportes/${slug}/`, Astro.site ?? Astro.url).href}
    />

    {noticia.imageUrl && (
      <figure class="mx-auto mt-8 max-w-4xl">
        <img
          src={noticia.imageUrl}
          alt=""
          loading="eager"
          decoding="async"
          referrerpolicy="no-referrer"
          class="h-auto w-full rounded-lg object-cover"
        />
        <figcaption class="mt-2 text-sm text-text-secondary">
          Imagen publicada por Olé. Todos los derechos corresponden a su titular.
        </figcaption>
      </figure>
    )}

    <div class="mx-auto mt-8 max-w-3xl">
      {descripcionNoticia && (
        <p class="mb-6 text-lg leading-relaxed text-text-secondary" data-ole-description>
          {descripcionNoticia}
        </p>
      )}

      <p class="text-lg leading-relaxed text-text-secondary">
        Esta página reúne los datos del feed deportivo de Olé dentro de QSK Noticias.
        El desarrollo de la noticia y su cobertura completa se encuentran en la publicación original.
      </p>

      <div class="mt-6 rounded-xl border border-border bg-surface p-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-text-secondary">Fuente original</p>
        <p class="mt-2 font-heading text-lg font-bold text-text">Olé</p>
        <a
          href={noticia.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex min-h-10 items-center rounded-full bg-accent px-5 py-2 text-sm font-bold text-bg transition hover:brightness-110"
        >
          Leer la noticia en Olé <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
