---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto — QSK Noticias"
  description="Canales de contacto de QSK Noticias."
>
  <div class="container-editorial py-10">
    <article class="mx-auto max-w-3xl">
      <h1 class="font-heading text-3xl font-extrabold tracking-tight text-text">
        Contacto
      </h1>

      <div class="prose-content mt-6 space-y-4 text-text">
        <p>
          Escribinos a{' '}
          <a class="link-accent" href="mailto:sebastian.a.quiroga@outlook.com.ar">sebastian.a.quiroga@outlook.com.ar</a>.
        </p>

        <p><strong>Asuntos sugeridos</strong></p>
        <ul class="list-disc space-y-1 pl-5">
          <li><strong>Consulta editorial</strong> — preguntas sobre la cobertura o la línea editorial.</li>
          <li><strong>Envío de información</strong> — datos, documentos o denuncias para considerar.</li>
          <li><strong>Reporte de error</strong> — posibles errores en artículos publicados.</li>
        </ul>
      </div>
    </article>
  </div>
</BaseLayout>
