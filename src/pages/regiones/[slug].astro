---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticlesByRegion } from '../../lib/articles';
import { getLocationsByType, locationSlug } from '../../data/locations';
import GacetillasPorFuente from '../../components/GacetillasPorFuente.astro';

export async function getStaticPaths() {
  return getLocationsByType('region').map((location) => ({
    params: { slug: locationSlug(location) },
    props: { region: location.name },
  }));
}

const { region } = Astro.props;
const sorted = await getArticlesByRegion(region);

const regionDescription =
  region === 'Zona Sur'
    ? 'Noticias de Zona Sur del Gran Buenos Aires en QSK Noticias.'
    : region === 'AMBA'
      ? 'Noticias del Área Metropolitana de Buenos Aires (AMBA) en QSK Noticias.'
      : `Noticias de la región ${region} en QSK Noticias.`;

const regionIntro =
  region === 'Zona Sur'
    ? 'Cobertura territorial de Zona Sur del Gran Buenos Aires, principal identidad y diferencial de QSK Noticias.'
    : region === 'AMBA'
      ? 'Actualidad metropolitana del Área Metropolitana de Buenos Aires.'
      : `Actualidad de la región ${region}.`;
---

<BaseLayout
  title={`${region} - QSK Noticias`}
  description={regionDescription}
>
  <div class="container-editorial py-10">
    <header>
      <h1 class="font-heading text-3xl font-extrabold tracking-tight text-text">
        {region}
      </h1>
      <p class="mt-2 text-text-secondary">
        {regionIntro}
      </p>
      <p class="mt-1 text-sm text-text-secondary">
        {sorted.length} {sorted.length === 1 ? 'artículo' : 'artículos'} de esta región.
      </p>
    </header>

    {sorted.length > 0 ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-text-secondary">
        No hay artículos publicados de esta región todavía.
      </p>
    )}

    {region === 'AMBA' && (
  <section class="mt-10">
    <GacetillasPorFuente fuenteId="gba" />
  </section>
)}
  </div>
</BaseLayout>
