---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticlesByLocalidad, getArticlesByMunicipality } from '../../lib/articles';
import { getLocationById, getLocationsByType, locationSlug } from '../../data/locations';

export async function getStaticPaths() {
  return getLocationsByType('localidad').map((location) => ({
    params: { slug: locationSlug(location) },
    props: { localidadId: location.id },
  }));
}

const { localidadId } = Astro.props;
const localidad = getLocationById(localidadId);
const municipio = localidad?.parentId ? getLocationById(localidad.parentId) : undefined;

// La localidad tiene artículos propios sólo si el frontmatter la etiqueta
// explícitamente (`localidad: "Banfield"`), porque `municipality` guarda el
// partido. Si no hay, se ofrecen los del partido como alternativa, sin
// mezclarlos con los de la localidad.
const articles = localidad ? await getArticlesByLocalidad(localidad.name) : [];
const municipioArticles =
  articles.length === 0 && municipio ? await getArticlesByMunicipality(municipio.name) : [];
---

<BaseLayout
  title={`${localidad?.name ?? 'Localidad'} — QSK Noticias`}
  description={`Noticias de ${localidad?.name ?? ''}${municipio ? `, partido de ${municipio.name}` : ''}, Zona Sur del conurbano bonaerense.`}
>
  <div class="container-editorial py-10">
    <header>
      <h1 class="font-heading text-3xl font-extrabold tracking-tight text-text">
        {localidad?.name}
      </h1>
      {municipio && (
        <p class="mt-2 text-text-secondary">
          Localidad del partido de{' '}
          <a href={`/municipios/${locationSlug(municipio)}/`} class="text-accent hover:underline">
            {municipio.name}
          </a>
          .
        </p>
      )}
      {articles.length > 0 && (
        <p class="mt-2 text-text-secondary">
          {articles.length} {articles.length === 1 ? 'artículo' : 'artículos'} de esta localidad.
        </p>
      )}
    </header>

    {articles.length > 0 ? (
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <li>
            <ArticleCard article={article} />
          </li>
        ))}
      </ul>
    ) : (
      <>
        <p class="mt-8 text-text-secondary">
          Todavía no hay artículos publicados de esta localidad.
        </p>
        {municipio && (
          <p class="mt-2 text-text-secondary">
            Mientras tanto, podés ver las noticias de{' '}
            <a href={`/municipios/${locationSlug(municipio)}/`} class="text-accent hover:underline">
              {municipio.name}
            </a>
            .
          </p>
        )}
        {municipioArticles.length > 0 && (
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {municipioArticles.map((article) => (
              <li>
                <ArticleCard article={article} variant="compact" />
              </li>
            ))}
          </ul>
        )}
      </>
    )}
  </div>
</BaseLayout>
