---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticlesByMunicipality } from '../../lib/articles';
import { getLocationsByType, locationSlug } from '../../data/locations';
import GacetillasPorFuente from '../../components/GacetillasPorFuente.astro';

export async function getStaticPaths() {
  return getLocationsByType('municipio').map((location) => ({
    params: { slug: locationSlug(location) },
    props: { municipality: location.name },
  }));
}

const { municipality } = Astro.props;
const sorted = await getArticlesByMunicipality(municipality);

---

<BaseLayout
  title={`${municipality} — QSK Noticias`}
  description={`Noticias de ${municipality} en Zona Sur del conurbano bonaerense.`}
>
  <div class="container-editorial py-10">
    <header>
      <h1 class="font-heading text-3xl font-extrabold tracking-tight text-text">
        {municipality}
      </h1>
      <p class="mt-2 text-text-secondary">
        {sorted.length} {sorted.length === 1 ? 'artículo' : 'artículos'} de este municipio.
      </p>
    </header>

    {sorted.length > 0 ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-text-secondary">
        No hay artículos publicados de este municipio todavía.
      </p>
    )}

{municipality === 'Esteban Echeverría' && (
  <section class="mt-10">
    <GacetillasPorFuente fuenteId="esteban-echeverria" />
  </section>
)}
  </div>
</BaseLayout>
