---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import GacetillasTarjetas from '../../../../components/GacetillasTarjetas.astro';
import {
  getGacetillasRecientesPorFuente,
  getGacetillasArchivoPorFuente,
  getFuentesConDatos,
  type FuenteInfo,
} from '../../../../lib/gacetillas';

export function getStaticPaths() {
  // Generar una ruta por cada fuente presente en los datos, incluida GBA.
  return getFuentesConDatos()
    .map((fuente) => ({
      params: { id: fuente.id },
      props: { fuenteInfo: fuente },
    }));
}

interface Props {
  fuenteInfo: FuenteInfo;
}

const { fuenteInfo } = Astro.props;
const nombre = fuenteInfo.nombre;
const listadoUrl = fuenteInfo.listadoUrl;
const recientes = getGacetillasRecientesPorFuente(fuenteInfo.id);
const archivo = getGacetillasArchivoPorFuente(fuenteInfo.id);
const otrasFuentes = getFuentesConDatos().filter((fuente) => fuente.id !== fuenteInfo.id);
---

<BaseLayout
  title={`Gacetillas de ${nombre} — QSK Noticias`}
  description={`Las últimas gacetillas oficiales de ${nombre}, reproducidas del listado oficial y enlazadas a su publicación original.`}
  canonical={`/gacetillas-oficiales/fuente/${fuenteInfo.id}/`}
>
  <div class="container-editorial pb-14 pt-7 sm:pt-10">
    <nav aria-label="Miga de pan" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-text-secondary">
        <li><a href="/" class="hover:text-text">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/gacetillas-oficiales/" class="hover:text-text">Gacetillas oficiales</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-text">{nombre}</li>
      </ol>
    </nav>

    <header class="mb-8 border-b border-border pb-6">
      <p class="eyebrow">Contenido oficial · Fuente externa</p>
      <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">Gacetillas de {nombre}</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-text-secondary">Esta sección reproduce los títulos, bajadas e imágenes disponibles en el listado oficial de {nombre}. El contenido no es redactado por QSK Noticias; cada tarjeta conserva su enlace a la publicación original.</p>
      <p class="mt-3">
        <a href={listadoUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-accent hover:underline">Ver el listado oficial <span aria-hidden="true">↗</span></a>
      </p>
      {
        otrasFuentes.length > 0 && (
          <nav aria-label="Otras fuentes oficiales" class="mt-3 flex flex-wrap gap-2">
            {otrasFuentes.map((fuente) => (
              <a
                href={`/gacetillas-oficiales/fuente/${fuente.id}/`}
                class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-text-secondary transition-colors hover:border-accent hover:text-accent"
              >
                {fuente.nombre}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <section aria-labelledby="recientes-heading">
      <div class="section-heading">
        <div>
          <h2 id="recientes-heading" class="section-title">Últimas gacetillas</h2>
          <p class="mt-1 text-sm text-text-secondary">Ordenadas de la más reciente a la más antigua, tal como aparecen en el listado oficial.</p>
        </div>
        <a href="/gacetillas-oficiales/" class="text-sm font-semibold text-accent hover:underline">Ver todas las fuentes <span aria-hidden="true">↗</span></a>
      </div>

      {
        recientes.length > 0 ? (
          <GacetillasTarjetas noticias={recientes} />
        ) : (
          <p class="rounded-xl border border-border p-5 text-sm text-text-secondary">Todavía no hay gacetillas de esta fuente en el dataset.</p>
        )
      }

      {
        archivo.length > 0 && (
          <div class="mt-4 text-right">
            <a
              href={`/gacetillas-oficiales/fuente/${fuenteInfo.id}/archivo/`}
              class="text-sm font-semibold text-accent hover:underline"
            >
              Ver archivo ({archivo.length} gacetillas anteriores) <span aria-hidden="true">↗</span>
            </a>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  import { guardExternalImage } from '../../../../lib/image-fallback';

  document
    .querySelectorAll<HTMLImageElement>('img[data-gacetilla-img]')
    .forEach((image) => guardExternalImage(image, '[data-gacetilla-img-fallback]'));
</script>
