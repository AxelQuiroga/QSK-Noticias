---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getGacetillasArchivo } from '../../../lib/gacetillas';

const gacetillas = getGacetillasArchivo();
---

<BaseLayout
  title="Archivo de gacetillas oficiales — QSK Noticias"
  description="Gacetillas anteriores del Gobierno de la Provincia de Buenos Aires. Ya no están entre las últimas novedades, pero conservan su página y su enlace a la publicación original."
  canonical="/gacetillas-oficiales/archivo/"
>
  <div class="container-editorial pb-14 pt-7 sm:pt-10">
    <header class="mb-8 border-b border-border pb-6">
      <p class="eyebrow">Contenido oficial · Fuente externa</p>
      <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">Archivo de gacetillas oficiales</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-text-secondary">Las gacetillas del Gobierno de la Provincia de Buenos Aires que ya no están entre las más recientes siguen disponibles desde acá, cada una con su página propia y el enlace a su publicación original. El contenido no es redactado por QSK Noticias.</p>
    </header>
    <section aria-labelledby="archivo-heading">
      <div class="section-heading">
        <div>
          <h2 id="archivo-heading" class="section-title">Gacetillas anteriores</h2>
          <p class="mt-1 text-sm text-text-secondary">Ordenadas de la más reciente a la más antigua, tal como aparecen en el listado oficial.</p>
        </div>
        <a href="/gacetillas-oficiales/" class="text-sm font-semibold text-accent hover:underline">Ver las recientes <span aria-hidden="true">↗</span></a>
      </div>
      {
        gacetillas.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2">
            {gacetillas.map((noticia) => (
              <article class="overflow-hidden rounded-xl border border-border bg-surface">
                {noticia.imagenUrl && (
                  <a href={`/gacetillas-oficiales/${noticia.slug}/`} tabindex="-1" aria-hidden="true" class="relative block aspect-[16/9] overflow-hidden bg-surface-raised">
                    <img
                      src={noticia.imagenUrl}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      data-gacetilla-img
                      class="h-full w-full object-cover"
                    />
                    <span data-gacetilla-img-fallback class="absolute inset-0 hidden">
                      <span class="flex h-full w-full flex-col items-center justify-center gap-2 text-text-secondary/60">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-8" aria-hidden="true">
                          <rect x="3" y="3" width="18" height="18" rx="2" />
                          <circle cx="8.5" cy="8.5" r="1.5" />
                          <path d="m21 15-5-5L5 21" />
                        </svg>
                        <span class="text-xs font-medium">Imagen no disponible</span>
                      </span>
                    </span>
                  </a>
                )}
                <div class="p-4 sm:p-5">
                  {noticia.volanta && <p class="text-xs font-bold uppercase tracking-wider text-accent">{noticia.volanta}</p>}
                  <h3 class="mt-2 text-lg font-extrabold leading-tight text-text">
                    <a href={`/gacetillas-oficiales/${noticia.slug}/`} class="hover:underline">{noticia.titulo}</a>
                  </h3>
                  {noticia.descripcion && <p class="mt-3 text-sm leading-relaxed text-text-secondary">{noticia.descripcion}</p>}
                  <p class="mt-4 text-xs font-semibold text-text-secondary">Fuente: Gobierno de la Provincia de Buenos Aires · <a href={noticia.urlNoticia} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">Publicación original</a></p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="rounded-xl border border-border p-5 text-sm text-text-secondary">Todavía no hay gacetillas en el archivo: las últimas doce siguen en la sección principal.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  import { guardExternalImage } from '../../../lib/image-fallback';

  document
    .querySelectorAll<HTMLImageElement>('img[data-gacetilla-img]')
    .forEach((image) => guardExternalImage(image, '[data-gacetilla-img-fallback]'));
</script>
