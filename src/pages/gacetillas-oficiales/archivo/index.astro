---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GacetillasTarjetas from '../../../components/GacetillasTarjetas.astro';
import { getGacetillasArchivo } from '../../../lib/gacetillas';

const gacetillas = getGacetillasArchivo();
---

<BaseLayout
  title="Archivo de gacetillas oficiales — QSK Noticias"
  description="Gacetillas anteriores de las fuentes oficiales. Ya no están entre las últimas novedades, pero conservan su página y su enlace a la publicación original."
  canonical="/gacetillas-oficiales/archivo/"
>
  <div class="container-editorial pb-14 pt-7 sm:pt-10">
    <header class="mb-8 border-b border-border pb-6">
      <p class="eyebrow">Contenido oficial · Fuente externa</p>
      <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">Archivo de gacetillas oficiales</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-text-secondary">Las gacetillas que ya no están entre las más recientes siguen disponibles desde acá, cada una con su página propia y el enlace a su publicación original.</p>
    </header>
    <section aria-labelledby="archivo-heading">
      <div class="section-heading">
        <div>
          <h2 id="archivo-heading" class="section-title">Gacetillas anteriores</h2>
          <p class="mt-1 text-sm text-text-secondary">Ordenadas de la más reciente a la más antigua, tal como aparecen en los listados oficiales.</p>
        </div>
        <a href="/gacetillas-oficiales/" class="text-sm font-semibold text-accent hover:underline">Ver las recientes <span aria-hidden="true">↗</span></a>
      </div>
      {
        gacetillas.length > 0 ? (
          <GacetillasTarjetas noticias={gacetillas} />
        ) : (
          <p class="rounded-xl border border-border p-5 text-sm text-text-secondary">Todavía no hay gacetillas en el archivo: las últimas doce siguen en la sección principal.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  import { guardExternalImage } from '../../../lib/image-fallback';

  document
    .querySelectorAll<HTMLImageElement>('img[data-gacetilla-img]')
    .forEach((image) => guardExternalImage(image, '[data-gacetilla-img-fallback]'));
</script>
