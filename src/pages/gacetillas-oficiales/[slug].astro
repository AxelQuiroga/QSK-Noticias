---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGacetillasConSlug, getFuenteInfo, type GacetillaConSlug } from '../../lib/gacetillas';
import { formatDate } from '../../lib/utils';

export function getStaticPaths() {
  return getGacetillasConSlug().map((gacetilla) => ({
    params: { slug: gacetilla.slug },
    props: { gacetilla },
  }));
}

interface Props {
  gacetilla: GacetillaConSlug;
}

const { gacetilla } = Astro.props;

// Fuente declarada del registro; el legado sin `fuente` es GBA (única
// fuente previa a la migración de la automatización).
const fuenteInfo = getFuenteInfo(gacetilla.fuente ?? 'gba');
const nombreFuenteRegistro = fuenteInfo?.nombre ?? 'Fuente externa';
const listadoUrl = fuenteInfo?.listadoUrl ?? 'https://www.gba.gob.ar/comunicacion_publica/gacetillas';

const cuerpoParrafos = (gacetilla.cuerpo ?? '')
  .split(/\n\s*\n/)
  .map((parrafo) => parrafo.trim())
  .filter(Boolean);

const fecha = gacetilla.fecha ? new Date(gacetilla.fecha) : null;
const fechaValida = fecha && !Number.isNaN(fecha.getTime()) ? fecha : null;
---

<BaseLayout
  title={`${gacetilla.titulo} — Gacetillas oficiales — QSK Noticias`}
  description={gacetilla.descripcion ?? gacetilla.titulo}
  canonical={`/gacetillas-oficiales/${gacetilla.slug}/`}
>
  <article class="container-editorial py-10">
    <nav aria-label="Miga de pan" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-text-secondary">
        <li><a href="/" class="hover:text-text">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/gacetillas-oficiales/" class="hover:text-text">Gacetillas oficiales</a></li>
      </ol>
    </nav>

    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">Gacetilla oficial · {nombreFuenteRegistro}</p>
      {gacetilla.volanta && (
        <p class="mt-2 text-xs font-bold uppercase tracking-wider text-accent">{gacetilla.volanta}</p>
      )}
      <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
        {gacetilla.titulo}
      </h1>
      {fechaValida && (
        <p class="mt-3 text-sm text-text-secondary">
          <time datetime={fechaValida.toISOString()}>{formatDate(fechaValida)}</time>
        </p>
      )}
    </header>

    {gacetilla.imagenUrl && (
      <figure class="mx-auto mt-8 max-w-4xl">
        <div class="relative aspect-[16/9] overflow-hidden rounded-lg bg-surface-raised">
          <img
            src={gacetilla.imagenUrl}
            alt=""
            loading="eager"
            decoding="async"
            data-gacetilla-detail-img
            class="h-full w-full object-cover"
          />
          <span data-gacetilla-detail-img-fallback class="absolute inset-0 hidden">
            <span class="flex h-full w-full flex-col items-center justify-center gap-2 text-text-secondary/60">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-8" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <path d="m21 15-5-5L5 21" />
              </svg>
              <span class="text-xs font-medium">Imagen no disponible</span>
            </span>
          </span>
        </div>
        <figcaption class="mt-2 text-sm text-text-secondary">Imagen: {nombreFuenteRegistro}.</figcaption>
      </figure>
    )}

    <div class="mx-auto mt-8 max-w-3xl">
      {gacetilla.descripcion && (
        <p data-gacetilla-bajada class="text-lg leading-relaxed text-text-secondary">{gacetilla.descripcion}</p>
      )}

      {cuerpoParrafos.length > 0 ? (
        <div class="prose-content mt-6">
          {cuerpoParrafos.map((parrafo) => <p>{parrafo}</p>)}
        </div>
      ) : (
        <div class="mt-6 rounded-xl border border-border bg-surface p-6">
  <p class="text-lg font-bold tracking-tight text-text">
    QSK Noticias
  </p>
  <p class="mt-2 text-sm leading-relaxed text-text-secondary">
    Información para entender lo que pasa. Periodismo para contar lo que importa.
  </p>
</div>
      )}

      <footer class="mt-10 border-t border-border pt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-text-secondary">Fuente</h2>
        <p class="mt-2 text-sm text-text">
          <strong class="font-semibold">{nombreFuenteRegistro}</strong>
          {fuenteInfo?.id === 'gba' && (
            <span class="text-text-secondary"> — Comunicación Pública</span>
          )}
        </p>
        <p class="mt-3 text-sm">
          <a
            href={gacetilla.urlNoticia}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-accent underline decoration-accent/50 underline-offset-4 hover:no-underline"
          >
            Ver publicación original <span aria-hidden="true">↗</span>
          </a>
        </p>
        <p class="mt-2 text-sm">
          <a
            href={listadoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline-offset-4 hover:underline"
          >
            Consultar todas las gacetillas de {nombreFuenteRegistro}
          </a>
        </p>
      </footer>

      <nav class="mt-10" aria-label="Volver">
        <a href="/#novedades-oficiales-heading" class="link-accent text-sm font-medium">
          &larr; Volver a Novedades oficiales
        </a>
      </nav>
    </div>
  </article>

  <script>
    import { guardExternalImage } from '../../lib/image-fallback';

    document
      .querySelectorAll<HTMLImageElement>('img[data-gacetilla-detail-img]')
      .forEach((image) => guardExternalImage(image, '[data-gacetilla-detail-img-fallback]'));
  </script>
</BaseLayout>
