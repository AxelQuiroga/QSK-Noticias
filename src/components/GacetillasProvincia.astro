---
import { getGacetillas } from '../lib/gacetillas';

interface Props {
  limit?: number;
}

const { limit = 4 } = Astro.props;
const noticias = getGacetillas(limit);
---

<section class="mt-10 sm:mt-12" aria-labelledby="gacetillas-heading">
  <div class="section-heading">
    <div>
      <h2 id="gacetillas-heading" class="section-title">Gacetillas oficiales</h2>
      <p class="mt-1 text-sm text-text-secondary">Contenido reproducido del listado del Gobierno de la Provincia de Buenos Aires.</p>
    </div>
    <a href="/gacetillas-oficiales/" class="text-sm font-semibold text-accent hover:underline">Ver todas <span aria-hidden="true">↗</span></a>
  </div>

  {noticias.length > 0 ? (
    <div class="grid gap-4 sm:grid-cols-2">
      {noticias.map((noticia) => (
        <article class="overflow-hidden rounded-xl border border-border bg-surface">
          {noticia.imagenUrl && (
            <a href={noticia.urlNoticia} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" class="relative block aspect-[16/9] overflow-hidden bg-surface-raised">
              <img
                src={noticia.imagenUrl}
                alt=""
                loading="lazy"
                decoding="async"
                data-gacetilla-img
                class="h-full w-full object-cover"
              />
              <span data-gacetilla-img-fallback class="absolute inset-0 hidden">
                <span class="flex h-full w-full flex-col items-center justify-center gap-2 text-text-secondary/60">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-8" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="m21 15-5-5L5 21" />
                  </svg>
                  <span class="text-xs font-medium">Imagen no disponible</span>
                </span>
              </span>
            </a>
          )}
          <div class="p-4 sm:p-5">
            {noticia.volanta && <p class="text-xs font-bold uppercase tracking-wider text-accent">{noticia.volanta}</p>}
            <h3 class="mt-2 text-lg font-extrabold leading-tight text-text">
              <a href={noticia.urlNoticia} target="_blank" rel="noopener noreferrer" class="hover:underline">{noticia.titulo}</a>
            </h3>
            {noticia.descripcion && <p class="mt-3 text-sm leading-relaxed text-text-secondary">{noticia.descripcion}</p>}
            <p class="mt-4 text-xs font-semibold text-text-secondary">Fuente: Gobierno de la Provincia de Buenos Aires · <a href={noticia.urlNoticia} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">Publicación original</a></p>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="rounded-xl border border-border p-5 text-sm text-text-secondary">Las gacetillas oficiales se actualizarán cuando la fuente vuelva a estar disponible.</p>
  )}
</section>

<script>
  function showImageFallback(image: HTMLImageElement): void {
    image.classList.add('hidden');
    const marker = image.parentElement?.querySelector<HTMLElement>('[data-gacetilla-img-fallback]');
    marker?.classList.remove('hidden');
  }

  function guardExternalImage(image: HTMLImageElement): void {
    // Los <script> de módulo son diferidos: una imagen lazy puede fallar
    // antes de que este script se ejecute, así que también revisamos el
    // estado ya asentado (complete sin tamaño natural = fallo de carga).
    if (image.complete && image.naturalWidth === 0) {
      showImageFallback(image);
      return;
    }
    image.addEventListener('error', () => showImageFallback(image), { once: true });
  }

  document.querySelectorAll<HTMLImageElement>('img[data-gacetilla-img]').forEach(guardExternalImage);
</script>
