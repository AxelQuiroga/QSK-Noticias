---
import gacetillas from '../data/gacetillas.json';

interface Props {
  limit?: number;
}

const { limit = 4 } = Astro.props;
const noticias = gacetillas.slice(0, limit);
---

<section class="mt-10 sm:mt-12" aria-labelledby="gacetillas-heading">
  <div class="section-heading">
    <div>
      <h2 id="gacetillas-heading" class="section-title">Gacetillas de la Provincia</h2>
      <p class="mt-1 text-sm text-text-secondary">Información publicada por el Gobierno bonaerense.</p>
    </div>
    <a href="/actualidad-bonaerense/" class="text-sm font-semibold text-accent hover:underline">Ver todas <span aria-hidden="true">↗</span></a>
  </div>

  {noticias.length > 0 ? (
    <div class="grid gap-4 sm:grid-cols-2">
      {noticias.map((noticia) => (
        <article class="overflow-hidden rounded-xl border border-border bg-surface">
          {noticia.imagenUrl && (
            <a href={noticia.urlNoticia} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" class="block aspect-[16/9] overflow-hidden bg-surface-raised">
              <img src={noticia.imagenUrl} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </a>
          )}
          <div class="p-4 sm:p-5">
            {noticia.volanta && <p class="text-xs font-bold uppercase tracking-wider text-accent">{noticia.volanta}</p>}
            <h3 class="mt-2 text-lg font-extrabold leading-tight text-text">
              <a href={noticia.urlNoticia} target="_blank" rel="noopener noreferrer" class="hover:underline">{noticia.titulo}</a>
            </h3>
            {noticia.descripcion && <p class="mt-3 text-sm leading-relaxed text-text-secondary">{noticia.descripcion}</p>}
            <p class="mt-4 text-xs font-semibold text-text-secondary">Fuente oficial · Gobierno de la Provincia de Buenos Aires</p>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="rounded-xl border border-border p-5 text-sm text-text-secondary">Las gacetillas oficiales se actualizarán cuando la fuente vuelva a estar disponible.</p>
  )}
</section>
