---
import { getGacetillas, getGacetillasArchivo, getFuentesConDatos } from '../lib/gacetillas';
import GacetillasTarjetas from './GacetillasTarjetas.astro';

interface Props {
  limit?: number;
}

const { limit = 4 } = Astro.props;
const noticias = getGacetillas(limit);
const archivo = getGacetillasArchivo();
// Secciones por fuente para las municipalidades que ya tienen registros
// (la sección provincial es esta misma).
const fuentesLocales = getFuentesConDatos().filter((fuente) => fuente.id !== 'gba');
---

<section class="mt-10 sm:mt-12" aria-labelledby="gacetillas-heading">
  <div class="section-heading">
    <div>
      <h2 id="gacetillas-heading" class="section-title">Gacetillas oficiales</h2>
      <p class="mt-1 text-sm text-text-secondary">Contenido reproducido de los listados oficiales de la Provincia de Buenos Aires y de las municipalidades.</p>
    </div>
    <a href="/gacetillas-oficiales/" class="text-sm font-semibold text-accent hover:underline">Ver todas <span aria-hidden="true">↗</span></a>
  </div>

  {
    fuentesLocales.length > 0 && (
      <nav aria-label="Fuentes locales" class="mt-3 flex flex-wrap gap-2">
        {fuentesLocales.map((fuente) => (
          <a
            href={`/gacetillas-oficiales/fuente/${fuente.id}/`}
            class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-text-secondary transition-colors hover:border-accent hover:text-accent"
          >
            {fuente.nombre}
          </a>
        ))}
      </nav>
    )
  }

  {noticias.length > 0 ? <GacetillasTarjetas noticias={noticias} enlacesExternos /> : (
    <p class="rounded-xl border border-border p-5 text-sm text-text-secondary">Las gacetillas oficiales se actualizarán cuando las fuentes vuelvan a estar disponibles.</p>
  )}
  {
    archivo.length > 0 && (
      <div class="mt-4 text-right">
        <a
          href="/gacetillas-oficiales/archivo/"
          class="text-sm font-semibold text-accent hover:underline"
        >
          Ver archivo ({archivo.length} gacetillas anteriores) <span aria-hidden="true">↗</span>
        </a>
      </div>
    )
  }
</section>

<script>
  import { guardExternalImage } from '../lib/image-fallback';

  document
    .querySelectorAll<HTMLImageElement>('img[data-gacetilla-img]')
    .forEach((image) => guardExternalImage(image, '[data-gacetilla-img-fallback]'));
</script>
