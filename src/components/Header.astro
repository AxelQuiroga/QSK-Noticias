---
import Logo from './Logo.astro';
import { slugify } from '../lib/utils';
import { SECTIONS } from '../data/sections';
import { getChildLocations, getLocationsByType, locationSlug } from '../data/locations';

const sections = SECTIONS;

/** Municipios con sus localidades hijas (relación territorial del catálogo). */
const municipios = getLocationsByType('municipio').map((municipio) => ({
  ...municipio,
  localidades: getChildLocations(municipio.id),
}));

const regiones = getLocationsByType('region');
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/95 backdrop-blur">
  <div class="container-editorial">
    <div class="flex h-16 items-center justify-between">
      <Logo variant="header" />

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
        {sections.map((section) => (
          <a
            href={`/secciones/${slugify(section)}/`}
            class="text-sm font-medium text-text-secondary transition-colors hover:text-text"
          >
            {section}
          </a>
        ))}
        <details class="group relative">
          <summary class="list-none cursor-pointer text-sm font-medium text-text-secondary transition-colors hover:text-text [&::-webkit-details-marker]:hidden">
            Municipios
          </summary>
          <ul class="absolute left-0 top-full z-50 mt-2 w-56 rounded-md border border-border bg-bg p-2 shadow-lg">
            {municipios.map((municipio) => (
              <li>
                <a
                  href={`/municipios/${locationSlug(municipio)}/`}
                  class="block rounded px-3 py-2 text-sm font-medium text-text-secondary transition-colors hover:bg-surface hover:text-text"
                >
                  {municipio.name}
                </a>
                {municipio.localidades.length > 0 && (
                  <ul class="mb-1 ml-3 border-l border-border pl-1">
                    {municipio.localidades.map((localidad) => (
                      <li>
                        <a
                          href={`/localidades/${locationSlug(localidad)}/`}
                          class="block rounded px-3 py-1.5 text-sm text-text-secondary transition-colors hover:bg-surface hover:text-text"
                        >
                          {localidad.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </details>
        <details class="group relative">
          <summary class="list-none cursor-pointer text-sm font-medium text-text-secondary transition-colors hover:text-text [&::-webkit-details-marker]:hidden">
            Regiones
          </summary>
          <ul class="absolute left-0 top-full z-50 mt-2 w-52 rounded-md border border-border bg-bg p-2 shadow-lg">
            {regiones.map((location) => (
              <li>
                <a
                  href={`/regiones/${locationSlug(location)}/`}
                  class="block rounded px-3 py-2 text-sm font-medium text-text-secondary transition-colors hover:bg-surface hover:text-text"
                >
                  {location.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
        <a
          href="/buscar/"
          class="text-sm font-medium text-text-secondary transition-colors hover:text-text"
        >
          Buscar
        </a>
      </nav>

      <button
        id="menu-toggle"
        class="inline-flex items-center justify-center rounded-md p-2 text-text-secondary hover:bg-surface hover:text-text lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-border lg:hidden"
    aria-label="Navegación móvil"
  >
    <div class="container-editorial py-4">
      <div class="space-y-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-text-secondary">Secciones</p>
          <ul class="mt-2 flex flex-col gap-3">
            {sections.map((section) => (
              <li>
                <a
                  href={`/secciones/${slugify(section)}/`}
                  class="block text-base font-medium text-text-secondary hover:text-text"
                >
                  {section}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-text-secondary">Municipios</p>
          <ul class="mt-2 flex flex-col gap-3">
            {municipios.map((municipio) => (
              <li>
                <a
                  href={`/municipios/${locationSlug(municipio)}/`}
                  class="block text-base font-medium text-text-secondary hover:text-text"
                >
                  {municipio.name}
                </a>
                {municipio.localidades.length > 0 && (
                  <ul class="mt-2 ml-3 flex flex-col gap-2 border-l border-border pl-3">
                    {municipio.localidades.map((localidad) => (
                      <li>
                        <a
                          href={`/localidades/${locationSlug(localidad)}/`}
                          class="block text-sm text-text-secondary hover:text-text"
                        >
                          {localidad.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-text-secondary">Regiones</p>
          <ul class="mt-2 flex flex-col gap-3">
            {regiones.map((location) => (
              <li>
                <a
                  href={`/regiones/${locationSlug(location)}/`}
                  class="block text-base font-medium text-text-secondary hover:text-text"
                >
                  {location.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <a
            href="/buscar/"
            class="block text-base font-medium text-text-secondary hover:text-text"
          >
            Buscar
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación');
      menu.classList.toggle('hidden');
    });
  }
</script>
