---
import Logo from './Logo.astro';
import { slugify } from '../lib/utils';
import { NAV_DIRECT, NAV_GROUPS } from '../data/sections';
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/95 backdrop-blur">
  <div class="container-editorial">
    <div class="flex h-16 items-center justify-between">
      <Logo variant="header" />

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
        <a
          href="/"
          class="text-sm font-medium text-text-secondary transition-colors hover:text-text"
        >
          Portada
        </a>

        {NAV_GROUPS.map((group) => (
          <div class="relative" data-nav-group>
            <button
              type="button"
              id={`nav-${slugify(group.label)}-button`}
              class="group inline-flex items-center gap-1 text-sm font-medium text-text-secondary transition-colors hover:text-text aria-expanded:text-text"
              aria-expanded="false"
              aria-controls={`nav-${slugify(group.label)}-menu`}
              data-nav-trigger
            >
              {group.label}
              <svg
                class="h-3 w-3 transition-transform group-aria-expanded:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>

            <ul
              id={`nav-${slugify(group.label)}-menu`}
              class="absolute top-full left-0 z-50 mt-2 hidden min-w-44 rounded-lg border border-border bg-surface p-2 shadow-lg"
              data-nav-menu
            >
              {group.sections.map((section) => (
                <li>
                  <a
                    href={`/secciones/${slugify(section)}/`}
                    class="block rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap text-text-secondary transition-colors hover:bg-bg hover:text-text"
                  >
                    {section}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        {NAV_DIRECT.map((section) => (
          <a
            href={`/secciones/${slugify(section)}/`}
            class="text-sm font-medium text-text-secondary transition-colors hover:text-text"
          >
            {section}
          </a>
        ))}

        <a
          href="/buscar/"
          class="text-sm font-medium text-text-secondary transition-colors hover:text-text"
        >
          Buscar
        </a>
      </nav>

      <button
        id="menu-toggle"
        class="inline-flex items-center justify-center rounded-md p-2 text-text-secondary hover:bg-surface hover:text-text lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-border lg:hidden"
    aria-label="Navegación móvil"
  >
    <div class="container-editorial py-4">
      <ul class="flex flex-col">
        <li>
          <a
            href="/"
            class="flex min-h-11 items-center text-base font-medium text-text-secondary transition-colors hover:text-text"
          >
            Portada
          </a>
        </li>

        {NAV_GROUPS.map((group) => (
          <li data-nav-group>
            <button
              type="button"
              id={`mobile-${slugify(group.label)}-button`}
              class="group flex min-h-11 w-full items-center justify-between gap-2 text-left text-base font-medium text-text-secondary transition-colors hover:text-text aria-expanded:text-text"
              aria-expanded="false"
              aria-controls={`mobile-${slugify(group.label)}-menu`}
              data-nav-trigger
            >
              {group.label}
              <svg
                class="h-4 w-4 shrink-0 transition-transform group-aria-expanded:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>

            <ul id={`mobile-${slugify(group.label)}-menu`} class="hidden pb-1" data-nav-menu>
              {group.sections.map((section) => (
                <li>
                  <a
                    href={`/secciones/${slugify(section)}/`}
                    class="flex min-h-11 items-center pl-4 text-base text-text-secondary transition-colors hover:text-text"
                  >
                    {section}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}

        {NAV_DIRECT.map((section) => (
          <li>
            <a
              href={`/secciones/${slugify(section)}/`}
              class="flex min-h-11 items-center text-base font-medium text-text-secondary transition-colors hover:text-text"
            >
              {section}
            </a>
          </li>
        ))}

        <li>
          <a
            href="/buscar/"
            class="flex min-h-11 items-center text-base font-medium text-text-secondary transition-colors hover:text-text"
          >
            Buscar
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  function bindMenuToggle() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.menuBound === 'true') return;

    toggle.dataset.menuBound = 'true';
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación');
      menu.classList.toggle('hidden');
    });
  }

  /**
   * Desplegables de los grupos temáticos (escritorio y móvil).
   *
   * Los listeners se registran UNA sola vez por documento, a nivel de módulo:
   * la delegación en `document` resuelve los nodos en cada clic, así que no hay
   * nada que re-bindear cuando ClientRouter reemplaza el header.
   *
   * ⚠️ Es a propósito que NO se re-registren en `astro:page-load`. Un guard del
   * tipo `documentElement.dataset.x = 'true'` NO sirve acá: ClientRouter
   * reemplaza los atributos de <html> con los de la página nueva en cada
   * navegación, así que la bandera se pierde, el registro se repite y se
   * acumula un listener por navegación. Con N listeners el mismo clic alterna
   * el grupo N veces: con N par el menú se abre y se cierra en el mismo clic y
   * el desplegable "no abre" (bug reproducido: abría en 0 y 2 navegaciones,
   * fallaba en 1 y 3).
   *
   * Patrón disclosure: el disparador es un <button> con `aria-expanded` +
   * `aria-controls`. Enter/Space lo activan de forma nativa, Escape cierra y
   * devuelve el foco al disparador, y un clic fuera o sobre una sección cierra
   * todo. No hay hover: el menú es operable solo con teclado.
   */
  function setGroupOpen(trigger: HTMLElement, open: boolean) {
    const group = trigger.closest<HTMLElement>('[data-nav-group]');
    const menu = group?.querySelector<HTMLElement>('[data-nav-menu]');
    trigger.setAttribute('aria-expanded', String(open));
    if (menu) menu.classList.toggle('hidden', !open);
  }

  function closeAllGroups(except: HTMLElement | null) {
    document.querySelectorAll<HTMLElement>('[data-nav-group]').forEach((group) => {
      if (group === except) return;
      const trigger = group.querySelector<HTMLElement>('[data-nav-trigger]');
      if (!trigger) return;
      if (trigger.getAttribute('aria-expanded') === 'true') setGroupOpen(trigger, false);
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest<HTMLElement>('[data-nav-trigger]');
    if (trigger) {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      // Un solo grupo abierto por vez: cerramos el resto antes de alternar.
      closeAllGroups(trigger.closest<HTMLElement>('[data-nav-group]'));
      setGroupOpen(trigger, !isOpen);
      return;
    }

    closeAllGroups(null);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const trigger = document.querySelector<HTMLElement>('[data-nav-trigger][aria-expanded="true"]');
    if (!trigger) return;
    setGroupOpen(trigger, false);
    trigger.focus();
  });

  // El menú móvil sí se re-bindea: el header se reemplaza en cada navegación y
  // el guard por elemento (`dataset.menuBound`) viaja con el nodo nuevo.
  document.addEventListener('astro:page-load', bindMenuToggle);
</script>
