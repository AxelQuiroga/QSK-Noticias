---
/**
 * Grilla de tarjetas de gacetillas oficiales, reutilizada por la portada,
 * el archivo global y las páginas por fuente.
 *
 * - `enlacesExternos` (portada/carrusel): el título y la imagen enlazan a la
 *   publicación original. Sin él (páginas internas): enlazan al detalle
 *   propio `/gacetillas-oficiales/<slug>/`.
 * - La atribución sale del campo `fuente` del registro; el legado sin
 *   fuente se interpreta como GBA (unica fuente previa a la migracion) y
 *   la "Publicación original" siempre enlaza al sitio oficial.
 * - Los textos se normalizan al mostrar (entidades HTML, etiquetas,
 *   espacios). El detalle individual conserva el texto completo sin
 *   truncar.
 * - El guard de imagen externa usa los mismos data-attributes que las
 *   páginas venían usando: cada página incluyye el script que activa
 *   `guardExternalImage`.
 */
import { nombreFuente } from '../lib/gacetillas';
import { normalizarTexto, formatearTitulo } from '../lib/normalizar-texto';
import { formatDate } from '../lib/utils';

interface NoticiaTarjeta {
  titulo: string;
  descripcion: string | null;
  imagenUrl: string | null;
  urlNoticia: string;
  volanta: string | null;
  slug?: string;
  fuente?: string;
  fecha?: string | null;
}

interface Props {
  noticias: NoticiaTarjeta[];
  enlacesExternos?: boolean;
}

const { noticias, enlacesExternos = false } = Astro.props;

const enlaceTarjeta = (noticia: NoticiaTarjeta): string =>
  enlacesExternos ? noticia.urlNoticia : `/gacetillas-oficiales/${noticia.slug}/`;

const fechaValida = (noticia: NoticiaTarjeta): Date | null => {
  if (!noticia.fecha) return null;
  const fecha = new Date(noticia.fecha);
  return fecha && !Number.isNaN(fecha.getTime()) ? fecha : null;
};
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    noticias.map((noticia) => (
      <article class="overflow-hidden rounded-xl border border-border bg-surface">
        {noticia.imagenUrl && (
          <a
            href={enlaceTarjeta(noticia)}
            target={enlacesExternos ? '_blank' : null}
            rel={enlacesExternos ? 'noopener noreferrer' : null}
            tabindex="-1"
            aria-hidden="true"
            class="relative block aspect-[16/9] overflow-hidden bg-surface-raised"
          >
            <img
              src={noticia.imagenUrl}
              alt=""
              loading="lazy"
              decoding="async"
              data-gacetilla-img
              class="h-full w-full object-cover"
            />
            <span data-gacetilla-img-fallback class="absolute inset-0 hidden">
              <span class="flex h-full w-full flex-col items-center justify-center gap-2 text-text-secondary/60">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-8" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <path d="m21 15-5-5L5 21" />
                </svg>
                <span class="text-xs font-medium">Imagen no disponible</span>
              </span>
            </span>
          </a>
        )}
        <div class="p-4 sm:p-5">
          {noticia.volanta && <p class="text-xs font-bold uppercase tracking-wider text-accent">{noticia.volanta}</p>}
          <p class="text-xs font-semibold text-text-secondary">Fuente: {nombreFuente(noticia.fuente)}</p>
          {fechaValida(noticia) && (
            <p class="text-xs text-text-secondary">
              <time datetime={fechaValida(noticia)!.toISOString()}>{formatDate(fechaValida(noticia)!)}</time>
            </p>
          )}
          <h3 class="mt-2 text-lg font-extrabold leading-tight text-text">
            <a
              href={enlaceTarjeta(noticia)}
              target={enlacesExternos ? '_blank' : null}
              rel={enlacesExternos ? 'noopener noreferrer' : null}
              class="hover:underline"
            >
              {formatearTitulo(noticia.titulo) ?? noticia.titulo}
            </a>
          </h3>
          {normalizarTexto(noticia.descripcion) && (
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-text-secondary">{normalizarTexto(noticia.descripcion)}</p>
          )}
          <p class="mt-4 text-xs font-semibold text-text-secondary">
            <a href={noticia.urlNoticia} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">
              Publicación original
            </a>
          </p>
        </div>
      </article>
    ))
  }
</div>
