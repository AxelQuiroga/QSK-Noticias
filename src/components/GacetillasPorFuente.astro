---
/**
 * Sección de gacetillas oficiales para una fuente específica.
 *
 * Muestra un encabezado con el nombre de la fuente, hasta `limit` tarjetas
 * ordenadas por fecha (más recientes primero) y un enlace propio para
 * consultar todas las publicaciones de esa fuente.
 *
 * No inventa datos: si la fuente no tiene registros, muestra un estado vacío.
 * No mezcla fuentes: cada instancia filtra por el identificador exacto de su
 * fuente.
 */
import { getGacetillasRecientesPorFuente, getFuenteInfo, nombreFuente, rutaFuenteGacetillas } from '../lib/gacetillas';
import GacetillasTarjetas from './GacetillasTarjetas.astro';

interface Props {
  /** Identificador de la fuente (ej. 'gba', 'esteban-echeverria'). */
  fuenteId: string;
  /** Cantidad máxima de tarjetas a mostrar. */
  limit?: number;
}

const { fuenteId, limit = 12 } = Astro.props;

const fuenteInfo = getFuenteInfo(fuenteId);
const nombre = fuenteInfo?.nombre ?? nombreFuente(fuenteId);
const noticias = getGacetillasRecientesPorFuente(fuenteId, limit);
const tieneDatos = noticias.length > 0;
---

<section aria-labelledby={`gacetillas-${fuenteId}-heading`}>
  <div class="section-heading mb-6">
    <div>
      <h2 id={`gacetillas-${fuenteId}-heading`} class="section-title">
        Gacetillas de {nombre}
      </h2>
      <p class="mt-1 text-sm text-text-secondary">
        Contenido reproducido del listado oficial de {nombre}.
      </p>
    </div>
    {tieneDatos && (
      <a
        href={rutaFuenteGacetillas(fuenteId)}
        class="shrink-0 whitespace-nowrap text-sm font-semibold text-accent hover:underline"
      >
        Ver más <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>

  {tieneDatos ? (
    <GacetillasTarjetas noticias={noticias} enlacesExternos={false} />
  ) : (
    <p class="rounded-xl border border-border p-5 text-sm text-text-secondary">
      Todavía no hay gacetillas de {nombre} en el dataset.
    </p>
  )}
</section>
