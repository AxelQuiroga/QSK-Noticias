---
const locations = [
  { id: 'lanus', name: 'Lanús' },
  { id: 'avellaneda', name: 'Avellaneda' },
  { id: 'lomas-de-zamora', name: 'Lomas de Zamora' },
  { id: 'almirante-brown', name: 'Almirante Brown' },
  { id: 'quilmes', name: 'Quilmes' },
  { id: 'berazategui', name: 'Berazategui' },
  { id: 'florencio-varela', name: 'Florencio Varela' },
  { id: 'esteban-echeverria', name: 'Esteban Echeverría' },
  { id: 'ezeiza', name: 'Ezeiza' },
  { id: 'presidente-peron', name: 'Presidente Perón' },
  { id: 'san-vicente', name: 'San Vicente' },
  { id: 'caba', name: 'CABA' },
];
---

<section class="mb-8 border-y border-border sm:mb-10" aria-label="El tiempo" data-weather-widget>
  <div class="flex flex-col gap-3 py-3 sm:flex-row sm:items-center sm:gap-5">
    <div class="flex min-w-0 flex-1 items-center gap-3">
      <span class="eyebrow shrink-0 text-[0.65rem]">Clima</span>
      <span class="shrink-0 text-2xl leading-none" data-weather-symbol aria-hidden="true">☁</span>
      <strong class="shrink-0 font-heading text-3xl font-extrabold leading-none tracking-tight text-text" data-weather-temperature>--°</strong>
      <div class="min-w-0 flex-1">
        <details class="weather-location-picker relative w-fit max-w-full">
          <summary class="flex max-w-full cursor-pointer list-none items-center gap-1.5 rounded-md py-0.5 text-sm font-bold text-text outline-none transition-colors hover:text-accent focus-visible:ring-2 focus-visible:ring-info [&::-webkit-details-marker]:hidden">
            <span class="truncate" data-weather-location-label>Lanús</span>
            <svg class="shrink-0 transition-transform [details[open]_&]:rotate-180" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="sr-only">Cambiar municipio</span>
          </summary>
          <div class="absolute left-0 top-full z-30 mt-2 max-h-[min(20rem,60vh)] w-64 max-w-[calc(100vw-2.5rem)] overflow-y-auto rounded-lg border border-border bg-surface p-1.5 shadow-xl">
            <p class="px-2.5 pb-1.5 pt-2 text-[0.65rem] font-bold uppercase tracking-wider text-text-secondary">Consultar clima de</p>
            {locations.map((location) => (
              <button
                type="button"
                data-weather-location-option
                data-location={location.id}
                aria-pressed={location.id === 'lanus' ? 'true' : 'false'}
                class:list={[
                  'flex w-full items-center justify-between gap-3 rounded-md px-2.5 py-2 text-left text-sm transition-colors hover:bg-surface-raised focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-info',
                  location.id === 'lanus' ? 'font-semibold text-accent' : 'text-text',
                ]}
              >
                <span>{location.name}</span>
                <span data-location-check class:list={['text-accent', location.id === 'lanus' ? '' : 'invisible']} aria-hidden="true">✓</span>
              </button>
            ))}
          </div>
        </details>
        <p class="mt-0.5 truncate text-sm text-text-secondary" data-weather-condition aria-live="polite">Consultando…</p>
      </div>
    </div>

    <div class="flex items-center justify-between gap-4 border-t border-border pt-2.5 sm:ml-auto sm:justify-end sm:border-0 sm:pt-0">
      <span class="text-xs text-text-secondary" data-weather-status role="status"></span>
      <details class="weather-details-toggle relative shrink-0">
        <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-text transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-info [&::-webkit-details-marker]:hidden">
          Más datos
          <svg class="transition-transform [details[open]_&]:rotate-180" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="absolute right-0 top-full z-20 mt-2 w-[min(19rem,calc(100vw-2rem))] rounded-xl border border-border bg-surface p-4 shadow-xl sm:w-80">
          <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
            <div><dt class="text-xs text-text-secondary">Sensación térmica</dt><dd class="mt-0.5 font-semibold text-text" data-weather-feels-like>--°</dd></div>
            <div><dt class="text-xs text-text-secondary">Prob. de lluvia (3 h)</dt><dd class="mt-0.5 font-semibold text-text" data-weather-rain>--%</dd></div>
            <div><dt class="text-xs text-text-secondary">Humedad</dt><dd class="mt-0.5 font-semibold text-text" data-weather-humidity>--%</dd></div>
            <div><dt class="text-xs text-text-secondary">Actualizado</dt><dd class="mt-0.5 font-semibold text-text" data-weather-updated>—</dd></div>
          </dl>
          <p class="mt-3 border-t border-border pt-3 text-xs leading-relaxed text-text-secondary">
            Datos de <a class="link-accent" href="https://www.weatherapi.com/" target="_blank" rel="noopener noreferrer">WeatherAPI.com</a>. Información orientativa; ante alertas, consultá los canales oficiales.
          </p>
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  type WeatherPayload = {
    location: string;
    temperatureC: number;
    feelsLikeC: number;
    humidity: number;
    chanceOfRain: number | null;
    condition: string;
    conditionCode: number;
    observedAt: string;
  };

  const conditionSymbol = (code: number): string => {
    if (code === 1000) return '☀';
    if ([1003, 1006, 1009].includes(code)) return '☁';
    if ([1030, 1135, 1147].includes(code)) return '🌫';
    if ([1063, 1150, 1153, 1180, 1183, 1186, 1189, 1192, 1195, 1240, 1243, 1246].includes(code)) return '🌧';
    if ([1087, 1273, 1276, 1279, 1282].includes(code)) return '⛈';
    if ([1066, 1069, 1072, 1114, 1117, 1210, 1213, 1216, 1219, 1222, 1225].includes(code)) return '🌨';
    return '🌤';
  };

  const formatTime = (value: string): string => {
    const parsed = new Date(value.replace(' ', 'T'));
    return Number.isNaN(parsed.getTime())
      ? value
      : parsed.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
  };

  const weatherWidgetCleanups = new Set<() => void>();

  const cleanupWeatherWidgets = () => {
    weatherWidgetCleanups.forEach((cleanup) => cleanup());
  };

  const initWeatherWidget = (root: HTMLElement) => {
    if (root.dataset.weatherInitialized === 'true') return;
    root.dataset.weatherInitialized = 'true';

    const locationPicker = root.querySelector<HTMLElement>('.weather-location-picker');
    const locationLabel = root.querySelector<HTMLElement>('[data-weather-location-label]');
    const locationOptions = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-weather-location-option]'));
    const status = root.querySelector<HTMLElement>('[data-weather-status]');
    const temperature = root.querySelector<HTMLElement>('[data-weather-temperature]');
    const symbol = root.querySelector<HTMLElement>('[data-weather-symbol]');
    const condition = root.querySelector<HTMLElement>('[data-weather-condition]');
    const feelsLike = root.querySelector<HTMLElement>('[data-weather-feels-like]');
    const rain = root.querySelector<HTMLElement>('[data-weather-rain]');
    const humidity = root.querySelector<HTMLElement>('[data-weather-humidity]');
    const updated = root.querySelector<HTMLElement>('[data-weather-updated]');

    let selectedLocation = 'lanus';
    let requestId = 0;
    let activeRequestController: AbortController | null = null;

    const lifecycleController = new AbortController();

    const refresh = async () => {
      activeRequestController?.abort();

      const controller = new AbortController();
      activeRequestController = controller;
      const currentRequestId = ++requestId;
      const locationId = selectedLocation;

      if (status) status.textContent = 'Actualizando';

      try {
        const response = await fetch(
          `/api/weather?location=${encodeURIComponent(locationId)}`,
          { signal: controller.signal },
        );

        if (!response.ok) {
          console.warn(`[QSK weather] API respondió HTTP ${response.status} para ${locationId}`);
          throw new Error(`weather HTTP ${response.status}`);
        }

        const weather = (await response.json()) as WeatherPayload;
        if (controller.signal.aborted || currentRequestId !== requestId || locationId !== selectedLocation) return;

        if (temperature) temperature.textContent = `${Math.round(weather.temperatureC)}°`;
        if (symbol) symbol.textContent = conditionSymbol(weather.conditionCode);
        if (condition) {
          condition.textContent = weather.condition === 'Cubierto' ? 'Cielo nublado' : weather.condition;
        }
        if (feelsLike) feelsLike.textContent = `${Math.round(weather.feelsLikeC)}°`;
        if (rain) rain.textContent = weather.chanceOfRain === null ? 's/d' : `${weather.chanceOfRain}%`;
        if (humidity) humidity.textContent = `${weather.humidity}%`;
        if (updated) updated.textContent = formatTime(weather.observedAt);
        if (status) status.textContent = '';
        root.dataset.weatherState = 'loaded';
      } catch (error) {
        if (controller.signal.aborted || currentRequestId !== requestId) return;

        console.error('[QSK weather] No se pudo actualizar el clima.', error);
        if (condition) condition.textContent = 'Clima no disponible por el momento';
        if (status) status.textContent = '';
        if (updated) updated.textContent = 'Sin actualización';
        root.dataset.weatherState = 'error';
      } finally {
        if (activeRequestController === controller) {
          activeRequestController = null;
        }
      }
    };

    locationOptions.forEach((option) => {
      option.addEventListener('click', () => {
        const nextLocation = option.dataset.location;
        if (!nextLocation || nextLocation === selectedLocation) {
          if (locationPicker instanceof HTMLDetailsElement) locationPicker.open = false;
          return;
        }

        selectedLocation = nextLocation;
        if (locationLabel) {
          locationLabel.textContent = option.querySelector('span')?.textContent?.trim() ?? nextLocation;
        }

        locationOptions.forEach((item) => {
          const selected = item === option;
          item.setAttribute('aria-pressed', String(selected));
          item.classList.toggle('font-semibold', selected);
          item.classList.toggle('text-accent', selected);
          item.classList.toggle('text-text', !selected);
          item.querySelector<HTMLElement>('[data-location-check]')?.classList.toggle('invisible', !selected);
        });

        if (locationPicker instanceof HTMLDetailsElement) locationPicker.open = false;
        if (condition) condition.textContent = 'Consultando…';
        void refresh();
      }, { signal: lifecycleController.signal });
    });

    const intervalId = window.setInterval(() => void refresh(), 30 * 60 * 1000);

    const cleanup = () => {
      window.clearInterval(intervalId);
      requestId++;
      activeRequestController?.abort();
      activeRequestController = null;
      lifecycleController.abort();
      delete root.dataset.weatherInitialized;
      weatherWidgetCleanups.delete(cleanup);
    };

    weatherWidgetCleanups.add(cleanup);
    void refresh();
  };

  const mountWeatherWidgets = () => {
    document.querySelectorAll<HTMLElement>('[data-weather-widget]').forEach(initWeatherWidget);
  };

  document.addEventListener('astro:before-swap', cleanupWeatherWidgets);
  document.addEventListener('astro:page-load', mountWeatherWidgets);
  mountWeatherWidgets();
</script>
