---
const locations = [
  { id: 'lanus', name: 'Lanús' },
  { id: 'avellaneda', name: 'Avellaneda' },
  { id: 'lomas-de-zamora', name: 'Lomas de Zamora' },
  { id: 'almirante-brown', name: 'Almirante Brown' },
  { id: 'quilmes', name: 'Quilmes' },
  { id: 'berazategui', name: 'Berazategui' },
  { id: 'florencio-varela', name: 'Florencio Varela' },
  { id: 'esteban-echeverria', name: 'Esteban Echeverría' },
  { id: 'ezeiza', name: 'Ezeiza' },
  { id: 'presidente-peron', name: 'Presidente Perón' },
  { id: 'san-vicente', name: 'San Vicente' },
  { id: 'caba', name: 'CABA' },
];
---

<section class="weather-strip" aria-label="El tiempo" data-weather-widget>
  <div class="weather-main">
    <span class="weather-label">EL TIEMPO</span>
    <span class="weather-symbol" data-weather-symbol aria-hidden="true">☁</span>
    <strong class="weather-temperature" data-weather-temperature>--°</strong>
    <label class="weather-location-label">
      <span class="sr-only">Consultar clima de</span>
      <select data-weather-location-select aria-label="Consultar clima de otro municipio">
        {locations.map((location) => <option value={location.id} selected={location.id === 'lanus'}>{location.name}</option>)}
      </select>
    </label>
    <span class="weather-condition" data-weather-condition>Consultando…</span>
    <span class="weather-status" data-weather-status role="status" aria-live="polite"></span>
    <details class="weather-more">
      <summary>Más datos <span aria-hidden="true">⌄</span></summary>
      <div class="weather-details">
        <p>Sensación térmica <strong data-weather-feels-like>--°</strong></p>
        <p>Lluvia próximas 3 h <strong data-weather-rain>--%</strong></p>
        <p>Humedad <strong data-weather-humidity>--%</strong></p>
        <p class="weather-updated" data-weather-updated>Actualización pendiente</p>
        <p class="weather-attribution">Datos de <a href="https://www.weatherapi.com/" target="_blank" rel="noopener noreferrer">WeatherAPI.com</a>. Información orientativa; consultá los canales oficiales ante alertas meteorológicas.</p>
      </div>
    </details>
  </div>
</section>

<style>
  .weather-strip {
    margin: 0 0 1.25rem;
    min-width: 0;
    border-block: 1px solid var(--color-border, #26394b);
    color: var(--color-text, #f4f7fb);
  }
  .weather-main {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .45rem .75rem;
    min-width: 0;
    padding: .55rem 0;
  }
  .weather-label {
    flex: 0 0 auto;
    color: var(--color-text-secondary, #a7b4c2);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .09em;
  }
  .weather-symbol { flex: 0 0 auto; font-size: 1.15rem; line-height: 1; }
  .weather-temperature {
    flex: 0 0 auto;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -.04em;
    line-height: 1.2;
  }
  .weather-location-label { min-width: 0; max-width: 100%; }
  .weather-location-label select {
    max-width: 100%;
    border: 0;
    border-radius: .25rem;
    background: transparent;
    color: var(--color-text, #f4f7fb);
    font-size: .82rem;
    font-weight: 700;
    cursor: pointer;
  }
  .weather-location-label select:focus-visible,
  .weather-more summary:focus-visible {
    outline: 2px solid var(--color-info, #69b9e8);
    outline-offset: 3px;
  }
  .weather-location-label option { color: #172536; background: #fff; }
  .weather-condition {
    min-width: 0;
    color: var(--color-text-secondary, #a7b4c2);
    font-size: .78rem;
    overflow-wrap: anywhere;
  }
  .weather-status {
    margin-left: auto;
    color: var(--color-text-secondary, #a7b4c2);
    font-size: .68rem;
  }
  .weather-more { flex: 0 0 auto; margin-left: auto; }
  .weather-more summary {
    color: var(--color-accent, #69b9e8);
    font-size: .75rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .weather-more summary::-webkit-details-marker { display: none; }
  .weather-more[open] { flex-basis: 100%; }
  .weather-more[open] summary { display: inline-block; margin-block: .2rem .65rem; }
  .weather-details {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .45rem 1.1rem;
    padding: .65rem .75rem .75rem;
    border-radius: .5rem;
    background: var(--color-surface, #101f2e);
    font-size: .75rem;
  }
  .weather-details p { display: flex; gap: .35rem; align-items: baseline; }
  .weather-details strong { font-weight: 700; }
  .weather-updated, .weather-attribution {
    color: var(--color-text-secondary, #a7b4c2);
    font-size: .68rem;
  }
  .weather-attribution { flex-basis: 100%; line-height: 1.45; }
  .weather-attribution a { color: var(--color-accent, #69b9e8); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 520px) {
    .weather-main { gap: .4rem .55rem; }
    .weather-label { font-size: .58rem; }
    .weather-condition { flex-basis: auto; }
    .weather-status { display: none; }
    .weather-more { margin-left: auto; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .weather-more summary { transition: color .15s ease; }
    .weather-more summary:hover { color: var(--color-text, #f4f7fb); }
  }
</style>

<script>
  type WeatherPayload = {
    location: string;
    temperatureC: number;
    feelsLikeC: number;
    humidity: number;
    chanceOfRain: number | null;
    condition: string;
    conditionCode: number;
    observedAt: string;
  };

  const conditionSymbol = (code: number): string => {
    if (code === 1000) return '☀';
    if ([1003, 1006, 1009].includes(code)) return '☁';
    if ([1030, 1135, 1147].includes(code)) return '🌫';
    if ([1063, 1150, 1153, 1180, 1183, 1186, 1189, 1192, 1195, 1240, 1243, 1246].includes(code)) return '🌧';
    if ([1087, 1273, 1276, 1279, 1282].includes(code)) return '⛈';
    if ([1066, 1069, 1072, 1114, 1117, 1210, 1213, 1216, 1219, 1222, 1225].includes(code)) return '🌨';
    return '🌤';
  };

  const formatTime = (value: string): string => {
    const parsed = new Date(value.replace(' ', 'T'));
    return Number.isNaN(parsed.getTime())
      ? value
      : parsed.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
  };

  const initWeatherWidget = (root: HTMLElement) => {
    if (root.dataset.weatherInitialized === 'true') return;
    root.dataset.weatherInitialized = 'true';

    const select = root.querySelector<HTMLSelectElement>('[data-weather-location-select]');
    const status = root.querySelector<HTMLElement>('[data-weather-status]');
    const temperature = root.querySelector<HTMLElement>('[data-weather-temperature]');
    const symbol = root.querySelector<HTMLElement>('[data-weather-symbol]');
    const condition = root.querySelector<HTMLElement>('[data-weather-condition]');
    const feelsLike = root.querySelector<HTMLElement>('[data-weather-feels-like]');
    const rain = root.querySelector<HTMLElement>('[data-weather-rain]');
    const humidity = root.querySelector<HTMLElement>('[data-weather-humidity]');
    const updated = root.querySelector<HTMLElement>('[data-weather-updated]');
    let isLoading = false;
    let requestId = 0;

    const refresh = async () => {
      if (isLoading || !select) return;
      isLoading = true;
      const currentRequestId = ++requestId;
      const locationId = select.value;
      if (status) status.textContent = 'Actualizando';
      try {
        const response = await fetch(`/api/weather?location=${encodeURIComponent(locationId)}`);
        if (!response.ok) throw new Error('weather unavailable');
        const weather = (await response.json()) as WeatherPayload;
        if (currentRequestId !== requestId || locationId !== select.value) return;
        if (temperature) temperature.textContent = `${Math.round(weather.temperatureC)}°`;
        if (symbol) symbol.textContent = conditionSymbol(weather.conditionCode);
        if (condition) condition.textContent = weather.condition;
        if (feelsLike) feelsLike.textContent = `${Math.round(weather.feelsLikeC)}°`;
        if (rain) rain.textContent = weather.chanceOfRain === null ? 's/d' : `${weather.chanceOfRain}%`;
        if (humidity) humidity.textContent = `${weather.humidity}%`;
        if (updated) updated.textContent = `Actualizado ${formatTime(weather.observedAt)}`;
        if (status) status.textContent = '';
        root.dataset.weatherState = 'loaded';
      } catch {
        if (currentRequestId === requestId) {
          if (condition) condition.textContent = 'Datos no disponibles';
          if (status) status.textContent = '';
          if (updated) updated.textContent = 'Intentá nuevamente más tarde';
          root.dataset.weatherState = 'error';
        }
      } finally {
        if (currentRequestId === requestId) isLoading = false;
      }
    };

    select?.addEventListener('change', () => {
      if (condition) condition.textContent = 'Consultando…';
      void refresh();
    });
    void refresh();
    window.setInterval(() => void refresh(), 30 * 60 * 1000);
  };

  const mountWeatherWidgets = () => {
    document.querySelectorAll<HTMLElement>('[data-weather-widget]').forEach(initWeatherWidget);
  };
  mountWeatherWidgets();
  document.addEventListener('astro:page-load', mountWeatherWidgets);
</script>
