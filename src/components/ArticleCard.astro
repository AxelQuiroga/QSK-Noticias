---
import { formatDate, slugify, type Article } from '../lib/articles';
import { findLocationByName, locationSlug } from '../data/locations';

interface Props {
  article: Article;
  variant?: 'default' | 'featured' | 'compact';
}

const { article, variant = 'default' } = Astro.props;
const { data } = article;
const sectionSlug = data.section ? slugify(data.section) : "";

const municipality = data.municipality ? findLocationByName(data.municipality) : undefined;
const municipalitySlug =
  municipality && municipality.type === 'municipio' ? locationSlug(municipality) : null;
---

<article class:list={[
  'group overflow-hidden rounded-xl border border-border bg-surface transition-colors duration-200 hover:border-[#42698c]',
  variant === 'featured' && data.image && 'grid lg:grid-cols-[1.08fr_0.92fr]',
]}>
  {data.image && variant !== 'compact' && (
    <a
      href={`/noticias/${data.slug}/`}
      class:list={[
        'block overflow-hidden bg-[#0b1c2e]',
        variant === 'featured' ? 'aspect-[16/9] lg:aspect-auto lg:min-h-[360px]' : 'aspect-[16/9]',
      ]}
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={data.image.src}
        alt=""
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
        loading={variant === 'featured' ? 'eager' : 'lazy'}
        decoding="async"
      />
    </a>
  )}

  <div class:list={[
    'flex min-w-0 flex-col p-5 sm:p-6',
    variant === 'featured' && 'justify-center lg:p-8',
    variant === 'compact' && 'p-4',
  ]}>
    <div class="flex flex-wrap items-center gap-2 text-xs text-text-secondary">
      <a href={`/secciones/${sectionSlug}/`} class="font-bold uppercase tracking-wider text-accent hover:underline">
        {data.section}
      </a>
      {municipality && municipalitySlug && (
        <>
          <span aria-hidden="true" class="text-text-secondary/70">·</span>
          <a href={`/municipios/${municipalitySlug}/`} class="hover:text-text">
            {municipality.name}
          </a>
        </>
      )}
    </div>

    <h3 class:list={[
      'mt-3 font-heading font-extrabold leading-tight tracking-tight text-text',
      variant === 'featured' ? 'text-2xl sm:text-3xl lg:text-4xl' : variant === 'compact' ? 'text-base' : 'text-lg sm:text-xl',
    ]}>
      <a href={`/noticias/${data.slug}/`} class="decoration-accent/70 decoration-2 underline-offset-4 group-hover:underline">
        {data.title}
      </a>
    </h3>

    {variant !== 'compact' && (
      <p class:list={[
        'mt-3 leading-relaxed text-text-secondary',
        variant === 'featured' ? 'text-base sm:text-lg' : 'text-sm',
      ]}>
        {data.description}
      </p>
    )}

    <div class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-text-secondary">
      <time datetime={data.publishedAt.toISOString()}>
        {formatDate(data.publishedAt)}
      </time>
      {data.updatedAt && (
        <>
          <span aria-hidden="true">·</span>
          <span>Actualizado: {formatDate(data.updatedAt)}</span>
        </>
      )}
    </div>
  </div>
</article>
