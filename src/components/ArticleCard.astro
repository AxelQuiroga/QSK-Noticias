---
import { formatDate, slugify, type Article } from '../lib/articles';
import { findLocationByName, locationSlug } from '../data/locations';

interface Props {
  article: Article;
  variant?: 'default' | 'featured' | 'compact';
}

const { article, variant = 'default' } = Astro.props;
const { data } = article;
const sectionSlug = data.section ? slugify(data.section) : "";

// Solo enlazamos si el valor del frontmatter pertenece al catálogo Y es un
// municipio. Asi evitamos URLs rotas (p. ej. `municipality: "AMBA"`, que es
// una region, no un municipio).
const municipality = data.municipality ? findLocationByName(data.municipality) : undefined;
const municipalitySlug =
  municipality && municipality.type === 'municipio' ? locationSlug(municipality) : null;
---

<article class:list={[
  'card',
  variant === 'featured' && 'border-l-4 border-l-accent',
  variant === 'compact' && 'p-4',
]}>
  <div class="flex flex-wrap items-center gap-2 text-xs text-text-secondary">
    <a href={`/secciones/${sectionSlug}/`} class="font-medium text-accent hover:underline">
      {data.section}
    </a>
    {municipality && municipalitySlug && (
      <>
        <span aria-hidden="true">·</span>
        <a href={`/municipios/${municipalitySlug}/`} class="hover:text-text">
          {municipality.name}
        </a>
      </>
    )}
  </div>

  <h3 class:list={[
    'mt-2 font-heading font-bold tracking-tight text-text',
    variant === 'featured' ? 'text-2xl sm:text-3xl' : variant === 'compact' ? 'text-base' : 'text-lg',
  ]}>
    <a href={`/noticias/${data.slug}/`} class="hover:underline">
      {data.title}
    </a>
  </h3>

  {variant !== 'compact' && (
    <p class="mt-2 text-sm text-text-secondary">
      {data.description}
    </p>
  )}

  <div class="mt-3 flex items-center gap-2 text-xs text-text-secondary">
    <time datetime={data.publishedAt.toISOString()}>
      {formatDate(data.publishedAt)}
    </time>
    {data.updatedAt && (
      <>
        <span aria-hidden="true">·</span>
        <span>Actualizado: {formatDate(data.updatedAt)}</span>
      </>
    )}
  </div>
</article>
